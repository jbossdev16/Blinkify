{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "WEB_ORIGIN",
    "GEMINI_API_KEY",
    "ANTHROPIC_API_KEY",
    "POLAR_ACCESS_TOKEN",
    "POLAR_PRODUCT_ID_STANDARD",
    "POLAR_PRODUCT_ID_PROFESSIONAL",
    "POLAR_PRODUCT_ID_AGENCY",
    "POLAR_PRODUCT_ID_STANDARD_ANNUAL",
    "POLAR_PRODUCT_ID_PROFESSIONAL_ANNUAL",
    "POLAR_PRODUCT_ID_AGENCY_ANNUAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "API_BACKEND_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "BLINKIFY_ADMIN_EMAILS"
      ]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "API_BACKEND_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "BLINKIFY_ADMIN_EMAILS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
