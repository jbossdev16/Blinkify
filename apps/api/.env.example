# Copy to apps/api/.env and fill in your own values.
# Never commit a real .env file.

PORT=4001
WEB_ORIGIN=http://localhost:3032

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI — required for image, video, and campaign generation
GEMINI_API_KEY=your-gemini-api-key

# Optional: Anthropic (email HTML copy)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Vertex AI instead of the Gemini API key
# PROJECT_ID=your-gcp-project
# LOCATION=global

# Optional: transactional email (Resend)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Blinkify <noreply@yourdomain.com>
# PUBLIC_SITE_URL=http://localhost:3032

# Optional: Polar.sh billing
# POLAR_ACCESS_TOKEN=
# POLAR_SANDBOX=true
# POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID_STANDARD=
# POLAR_PRODUCT_ID_STANDARD_ANNUAL=
# POLAR_PRODUCT_ID_PROFESSIONAL=
# POLAR_PRODUCT_ID_PROFESSIONAL_ANNUAL=
# POLAR_PRODUCT_ID_AGENCY=
# POLAR_PRODUCT_ID_AGENCY_ANNUAL=
