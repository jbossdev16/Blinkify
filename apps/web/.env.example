# Copy to apps/web/.env.local and fill in your own values.
# Never commit a real .env or .env.local file.
# NEXT_PUBLIC_* values are baked into the client bundle at build time.

NEXT_PUBLIC_APP_URL=http://localhost:3032
NEXT_PUBLIC_API_URL=http://localhost:4001

# Same Supabase project as the API (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production only: URL of the Express API so Next.js can proxy /auth, /workspaces, etc.
# API_BACKEND_URL=https://api.yourdomain.com

# Server-only. Comma-separated emails that can open /admin.
# BLINKIFY_ADMIN_EMAILS=you@yourdomain.com

# Waitlist route on the Next.js app (optional; same keys as the API)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Blinkify <noreply@yourdomain.com>
